# One Inbox for Claude: copy to .env. Everything works in mock mode as-is.
# Never commit .env. Values here are placeholders.

# --- App -------------------------------------------------------------------
PORT=3000
# Public URL used in approve/reject links and OAuth redirects. Use your tunnel URL
# (e.g. cloudflared/ngrok) when testing webhooks or phone links in real mode.
APP_URL=http://localhost:3000
# 127.0.0.1 keeps the app local. Docker sets 0.0.0.0 inside the container.
HOST=127.0.0.1
DATA_DIR=./data
# Name shown in the audit log for actions taken in the web UI.
OPERATOR_NAME=you@web-ui

# --- Mock mode (on by default) ---------------------------------------------
# true  = every channel replays seeded conversations, no credentials needed.
# false = every channel runs real. Override one channel with <CHANNEL>_MODE=real|mock.
MOCK_MODE=true
# Scripted inbound messages that arrive 45s / 100s / 160s after startup.
MOCK_REPLAY=true
SYNC_INTERVAL_SECONDS=30

# --- Secrets & safety ------------------------------------------------------
# Encrypts connector credentials at rest (AES-256-GCM). 32+ chars.
# The server refuses to start in real mode while this is the example value.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ENCRYPTION_KEY=dev-only-change-me-0123456789abcdef0123456789
# Signs approve/reject links. Defaults to ENCRYPTION_KEY when empty.
LINK_SIGNING_SECRET=
# 1 = block every outgoing send regardless of the UI toggle.
SEND_KILL_SWITCH=0
DEFAULT_RATE_LIMIT_PER_HOUR=20
# Bearer token required on /mcp and /sse when set. Set it whenever the port is
# reachable from anywhere but your own machine (e.g. for Make).
MCP_HTTP_TOKEN=

# --- LLM for AI helpers (digest, suggestions, priority tags) ----------------
# fake = deterministic, offline. anthropic | openai (any OpenAI-compatible API).
LLM_PROVIDER=fake
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Approval notifications (optional) -------------------------------------
# Without these, notifications go to the local outbox (Settings page).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# e.g. smtps://user:pass@smtp.example.com:465
NOTIFY_SMTP_URL=
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=One Inbox <no-reply@example.com>

# --- Gmail (Google OAuth + Gmail API) --------------------------------------
GMAIL_MODE=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Outlook / Hotmail (Microsoft OAuth + Graph) ---------------------------
OUTLOOK_MODE=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# "consumers" for personal Outlook/Hotmail only, "common" for both personal and work.
MS_TENANT=common

# --- Yahoo (IMAP/SMTP with an app password) --------------------------------
YAHOO_MODE=
YAHOO_EMAIL=
YAHOO_APP_PASSWORD=

# --- Discord (official BOT only, never a user token) -----------------------
DISCORD_MODE=
DISCORD_BOT_TOKEN=
# Comma-separated channel or DM channel ids the bot should watch.
DISCORD_CHANNEL_IDS=

# --- WhatsApp Business Cloud API (business number only) --------------------
WHATSAPP_MODE=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v23.0
